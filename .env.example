# Backend storage and database
CDAS_DATABASE_URL=sqlite:///./storage/cdas.db
CDAS_DOCUMENTS_DIR=./storage/documents
CDAS_CHROMA_PERSIST_DIR=./storage/chroma
CDAS_AI_LOGS_DIR=./storage
CDAS_AUTH_SECRET_KEY=replace-with-a-long-random-secret
CDAS_AUTH_TOKEN_EXPIRE_HOURS=24

# CORS (comma-separated origins + optional regex)
CDAS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CDAS_CORS_ALLOW_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1):\d+$

# DeepSeek (generation)
CDAS_DEEPSEEK_API_KEY=
CDAS_DEEPSEEK_MODEL=deepseek-chat

# SiliconFlow (embedding and rerank)
CDAS_SILICONFLOW_API_KEY=
CDAS_SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
CDAS_SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
